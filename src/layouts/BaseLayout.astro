---
import '@/styles/global.css'
import { ClientRouter } from 'astro:transitions'

type Props = {
	title: string
	description: string
	lang?: string
	viewTransitions?: boolean
}

const { title, description, lang = 'en', viewTransitions = false } = Astro.props
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href="/site.webmanifest">
		<link rel="preload" href="/Geist%5Bwght%5D.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="stylesheet" href="/fonts.css" />
		<title>{title}</title>
		{viewTransitions && <ClientRouter />}
	</head>
	<body>
		<slot />
		<textarea id="clipboard-fallback" class="fixed -left-[9999px] top-0" aria-hidden="true" tabindex="-1"></textarea>
	</body>
</html>
