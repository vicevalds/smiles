---
import ActionButton from '@/components/ActionButton.astro'
import GraphAxis from '@/components/GraphAxis.astro'
import PillButton from '@/components/PillButton.astro'
---

<template id="chart-template">
	<li class="overflow-hidden border-2 border-accent-2">
		<div class="flex items-center justify-between gap-2 border-b border-accent-2 p-2">
			<span data-title class="min-w-0 flex-1 truncate font-mono text-xs"></span>
			<PillButton data-stat aria-label="Cycle statistic" grow={false} padded={false} class="w-[calc(6ch+1rem)] shrink-0 px-1.5 font-mono text-xs leading-none">
				Mean
			</PillButton>
			<button
				data-remove
				type="button"
				aria-label="Remove graph"
				class="shrink-0 cursor-pointer px-1 font-semibold leading-none hover:text-red-600"
			>&times;</button>
		</div>
		<div
			data-plot
			class:list={[
				"p-2 [&_svg]:h-auto [&_svg]:w-full [&_svg]:select-none [&_svg]:font-mono [&_[data-axis-label]]:text-[11px] [&_[data-chart-tip]]:text-[10px] [&_[data-chart-overlay]]:cursor-crosshair",
				"[&_.chart-root]:text-gray-500 [&_.chart-band]:fill-accent-2 [&_.chart-band]:[fill-opacity:0.25]",
				"[&_.chart-bar]:fill-accent-2 [&_.chart-bar[data-active=true]]:fill-gray-600",
				"[&_.chart-line]:fill-none [&_.chart-line]:stroke-gray-600 [&_.chart-line]:stroke-[1.5]",
				"[&_.chart-point]:fill-gray-600 [&_.chart-point]:[r:2.5] [&_[data-axis-label]]:fill-gray-600 [&_[data-chart-tip]]:fill-gray-600",
				"[&_.chart-crosshair]:stroke-gray-400 [&_.chart-crosshair]:[stroke-dasharray:3_3]",
				"[&_.chart-hover-point]:fill-none [&_.chart-hover-point]:[r:4] [&_.chart-hover-point]:stroke-gray-700 [&_.chart-hover-point]:stroke-[1.5]",
				"[&_.chart-tooltip-bg]:fill-white [&_.chart-tooltip-bg]:[rx:2] [&_.chart-tooltip-bg]:stroke-gray-400",
				"[&_[data-visible=false]]:hidden [&_[data-chart-tip-box]]:pointer-events-none [&_[data-chart-overlay]]:fill-none [&_[data-chart-overlay]]:[pointer-events:all]",
			]}
		></div>
	</li>
</template>

<template id="creator-template">
	<li data-creator class="flex aspect-[9/8] min-h-80 flex-col gap-2 overflow-hidden border-2 border-dashed border-gray-300 p-3 [contain:size]">
		<GraphAxis axis="y" />
		<GraphAxis axis="x" />
		<ActionButton data-create disabled class="shrink-0">Create</ActionButton>
	</li>
</template>

<template id="plot-empty-template">
	<p class="text-sm text-gray-500">No data to plot.</p>
</template>
