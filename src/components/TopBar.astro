---
import Count from '@/components/Count.astro'

type Props = {
	summaryLabel: string
	totalLabel: string
	sticky?: boolean
	controlsFirst?: boolean
}

const {
	summaryLabel,
	totalLabel,
	sticky = true,
	controlsFirst = false,
} = Astro.props
---

<div
	id="summary-bar"
	class:list={[
		'pb-2 pl-4 bg-white flex items-center',
		controlsFirst ? 'gap-3' : 'gap-8',
		sticky && 'sticky top-0 z-20 -mt-8 pt-8',
	]}
>
	<p
		id="render-summary"
		class:list={[
			'tabular-nums text-gray-500 whitespace-nowrap',
			controlsFirst && 'order-2',
		]}
		role="status"
		aria-live="polite"
		hidden
	><Count dataAttribute="rendered">0</Count> {summaryLabel}</p>
	<slot name="controls" />
	<p
		id="render-total"
		class:list={[
			'tabular-nums text-gray-500 ml-auto pr-4 whitespace-nowrap',
			controlsFirst && 'order-3',
		]}
		hidden
	>
		<Count dataAttribute="total-rendered">0</Count> {totalLabel}
	</p>
</div>
