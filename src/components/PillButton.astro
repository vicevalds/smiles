---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {
	grow?: boolean
	padded?: boolean
}

const {
	grow = true,
	padded = true,
	class: className,
	type = 'button',
	...attributes
} = Astro.props
---

<button
	{...attributes}
	type={type}
	class:list={[
		'inline-flex h-[26px] cursor-pointer items-center justify-center whitespace-nowrap border-2 border-accent-2 py-0 text-black hover:border-accent-2 hover:bg-accent-2 aria-pressed:border-accent-2 aria-pressed:bg-accent-2',
		grow && 'grow',
		padded ? 'px-2' : 'px-0',
		className,
	]}
>
	<slot />
</button>

<style>
	button:is([data-slot='1'], [data-slot='3']) {
		border-color: var(--color-gray-600);
		background: var(--color-gray-600);
		color: white;
	}
</style>
