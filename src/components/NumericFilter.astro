---
import ControlRow from '@/components/ControlRow.astro'
import NumericFilterFields from '@/components/NumericFilterFields.astro'

interface Props {
	id: string
	label: string
	defaultValue?: string
	placeholder?: string
	min?: number
}

const { id, label, defaultValue, placeholder, min } = Astro.props
---

<ControlRow id={id} {label} data-filter-label={label} wideLabel hidden>
	<NumericFilterFields {label} {defaultValue} {placeholder} {min} />
</ControlRow>
