---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {
	icon?: 'camera' | 'eye'
	label: string
}

const { icon = 'eye', label, class: className, ...attributes } = Astro.props
---

<button
	{...attributes}
	type="button"
	title={label}
	aria-label={label}
	aria-pressed={icon === 'eye' ? 'false' : undefined}
	class:list={[
		'group/camera inline-flex cursor-pointer text-gray-400 hover:text-black aria-pressed:text-black disabled:cursor-wait disabled:opacity-40 hidden:hidden',
		className,
	]}
>
	<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.875" aria-hidden="true">
		{icon === 'camera' ? (
			<g>
				<path d="M13.872 4.5a1.88 1.88 0 0 1 1.65.984l.456.844a1.88 1.88 0 0 0 1.65.984H19.5a1.875 1.875 0 0 1 1.875 1.875v8.438A1.875 1.875 0 0 1 19.5 19.5h-15a1.875 1.875 0 0 1-1.875-1.875V9.188A1.875 1.875 0 0 1 4.5 7.312h1.872a1.88 1.88 0 0 0 1.65-.982l.458-.848a1.88 1.88 0 0 1 1.649-.982z"/>
				<path d="M12 15.75a2.812 2.812 0 1 0 0-5.625 2.812 2.812 0 0 0 0 5.625"/>
			</g>
		) : (
			<>
				<g class="group-aria-pressed/camera:hidden">
					<path d="M2.683 12.326a.94.94 0 0 1 0-.652 10.078 10.078 0 0 1 18.634 0 .94.94 0 0 1 0 .652 10.077 10.077 0 0 1-18.634 0"/>
					<path d="M12 14.813a2.812 2.812 0 1 0 0-5.625 2.812 2.812 0 0 0 0 5.624"/>
				</g>
				<g class="hidden group-aria-pressed/camera:block">
					<path d="M10.812 5.509a10.07 10.07 0 0 1 10.505 6.164.94.94 0 0 1 0 .652c-.345.836-.8 1.62-1.354 2.335m-6.01-.637a2.812 2.812 0 0 1-3.976-3.977m7.16 7.11a10.078 10.078 0 0 1-14.454-4.83.94.94 0 0 1 0-.652 10.08 10.08 0 0 1 4.168-4.822M2.625 2.625l18.75 18.75"/>
				</g>
			</>
		)}
	</svg>
</button>
