---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {}

const {
	class: className,
	type = 'button',
	...attributes
} = Astro.props
---

<button
	{...attributes}
	data-copy-smiles
	type={type}
	class:list={[
		'cursor-pointer border border-accent-2 bg-white px-1 font-sans text-[10px] leading-4 text-black hover:bg-accent-2',
		className,
	]}
>
	<slot>Copy</slot>
</button>
