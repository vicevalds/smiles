---
type Props = {
	dataAttribute: 'rendered' | 'total-rendered'
}

const { dataAttribute } = Astro.props
const attributes = { [`data-${dataAttribute}`]: '' }
---

<span {...attributes} class="inline-block min-w-[calc(attr(data-digits_type(<number>),0)*1ch)] text-right font-semibold tabular-nums text-black"><slot /></span>
