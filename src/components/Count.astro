---
type Props = {
	dataAttribute: 'rendered' | 'total-rendered'
}

const { dataAttribute } = Astro.props
const attributes = { [`data-${dataAttribute}`]: '' }
---

<span {...attributes} class="inline-block min-w-[var(--count-width,0px)] text-right font-semibold tabular-nums text-black"><slot /></span>
