---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'select'> {}

const { class: className, ...attributes } = Astro.props
---

<select
	{...attributes}
	class:list={[
		'h-[26px] cursor-pointer border-0 border-b-2 border-accent bg-transparent px-1 font-semibold text-black focus:border-gray-400 focus:outline-none',
		className,
	]}
>
	<slot />
</select>
