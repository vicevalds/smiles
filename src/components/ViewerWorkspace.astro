---
import AppShell from '@/components/AppShell.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ColumnFilters from '@/components/ColumnFilters.astro'
import GraphTemplates from '@/components/GraphTemplates.astro'
import MoleculeCard from '@/components/MoleculeCard.astro'
import Slicer from '@/components/Slicer.astro'
import SmilesForm from '@/components/SmilesForm.astro'
import TopBar from '@/components/TopBar.astro'
import { REINVENT_EXAMPLE, SMILES_EXAMPLE } from '@/scripts/lib/examples'

type Props = {
	mode: 'smiles' | 'reinvent'
}

const { mode } = Astro.props
const isReinvent = mode === 'reinvent'
---

<BaseLayout
	title={isReinvent ? '*.smi | REINVENT' : '*.smi'}
	description={isReinvent
		? 'View and graph REINVENT output in the browser.'
		: 'Paste or upload SMILES strings and render 2D molecule structures in the browser.'}
	viewTransitions
>
	<AppShell active={mode} viewerMode={mode}>
		<SmilesForm
			slot="sidebar"
			placeholderSmiles={isReinvent ? REINVENT_EXAMPLE : SMILES_EXAMPLE}
			blurOnEnter={isReinvent}
			uploadLabel={isReinvent ? 'Upload a .csv/.tsv file' : 'Upload a .smi/.csv/.tsv file'}
			fileAccept={isReinvent
				? '.csv,.tsv,text/csv,text/tab-separated-values,text/plain'
				: '.smi,.csv,.tsv,text/csv,text/tab-separated-values,text/plain'}
		>
			{!isReinvent && <ColumnFilters slot="form-options" />}
		</SmilesForm>

		<TopBar
			summaryLabel="Molecules"
			totalLabel="Molecules"
			controlsFirst={isReinvent}
		>
			<Slicer
				slot="controls"
				idPrefix="step"
				label="Step"
				showTotal={isReinvent}
				grow={!isReinvent}
			/>
		</TopBar>

		<section
			id="gallery-section"
			aria-labelledby="gallery-title"
			data-gallery-rows={!isReinvent ? '3' : undefined}
			class="pl-4"
		>
			<h1 id="gallery-title" class="sr-only">Rendered molecules</h1>
			<ul
				id="gallery"
				data-columns="5"
				data-card-rows="1"
				class:list={[
					"grid gap-4 pr-4 data-[columns='2']:grid-cols-2 data-[columns='3']:grid-cols-3 data-[columns='4']:grid-cols-4 data-[columns='5']:grid-cols-5 data-[columns='6']:grid-cols-6 data-[columns='7']:grid-cols-7 data-[columns='8']:grid-cols-8",
					!isReinvent && 'scrollbar-hover overflow-y-auto',
				]}
			></ul>
		</section>

		{isReinvent && (
			<section id="graphs-section" aria-labelledby="graphs-title" class="pl-4" hidden>
				<h1 id="graphs-title" class="sr-only">Graphs</h1>
				<ul id="graphs" class="grid grid-cols-3 gap-4"></ul>
			</section>
		)}

		<MoleculeCard virtualized />
		{isReinvent && <GraphTemplates />}
	</AppShell>

	<script src="@/scripts/viewer.ts"></script>
</BaseLayout>

<style>
	#gallery-section[data-gallery-rows] {
		--visible-row-count: attr(data-gallery-rows type(<number>), 3);
		container-type: inline-size;
	}

	#gallery-section[data-gallery-rows] #gallery {
		--column-count: attr(data-columns type(<number>), 5);
		--card-row-count: attr(data-card-rows type(<number>), 1);
		--caption-height: calc(2.25rem * var(--card-row-count));
		--card-width: calc((100cqw - (var(--column-count) - 1) * 1rem) / var(--column-count));
		inline-size: calc(100% + 0.5rem);
		max-height: calc(
			(var(--card-width) + var(--caption-height)) * var(--visible-row-count) +
			(var(--visible-row-count) - 1) * 1rem
		);
		scrollbar-gutter: stable;
	}
</style>
