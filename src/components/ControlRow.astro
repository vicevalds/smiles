---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'section'> {
	label: string
	wideLabel?: boolean
}

const { label, wideLabel = false, class: className, ...attributes } = Astro.props
---

<section {...attributes} class:list={['flex h-[26px] items-center gap-2', className]}>
	<span class:list={['shrink-0 whitespace-nowrap font-semibold', wideLabel && 'w-32']}>{label}</span>
	<div class="flex h-full min-w-0 flex-1 flex-nowrap items-center gap-1">
		<slot />
	</div>
</section>
