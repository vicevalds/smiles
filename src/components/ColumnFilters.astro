---
import NumericFilterFields from '@/components/NumericFilterFields.astro'
import UnderlineSelect from '@/components/UnderlineSelect.astro'
---

<div id="column-filters" class="flex flex-col gap-2" hidden>
	<span class="font-semibold">Filters</span>
	<div id="column-filter-list" class="flex flex-col gap-2"></div>
	<template id="column-filter-template">
		<section class="flex h-[26px] items-center gap-2">
			<UnderlineSelect
				data-filter-column
				aria-label="Filter column"
				class="w-32 shrink-0"
			>
				<option value=""></option>
			</UnderlineSelect>
			<div class="flex h-full min-w-0 flex-1 flex-nowrap items-center gap-1">
				<NumericFilterFields disabled />
			</div>
		</section>
	</template>
</div>
