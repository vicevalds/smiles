---
import AppShell from '@/components/AppShell.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import MoleculeCard from '@/components/MoleculeCard.astro'
import NeighborSort from '@/components/NeighborSort.astro'
import NumericFilter from '@/components/NumericFilter.astro'
import Slicer from '@/components/Slicer.astro'
import SmilesForm from '@/components/SmilesForm.astro'
import TopBar from '@/components/TopBar.astro'
import { NEIGHBOR_EXAMPLE } from '@/scripts/lib/examples'
---

<BaseLayout title="*.smi | NN" description="View a Nearest Neighbor output" viewTransitions>
	<AppShell active="nn">
		<SmilesForm
			slot="sidebar"
			placeholderSmiles={NEIGHBOR_EXAMPLE}
			uploadLabel="Upload a .csv/.tsv file"
			fileAccept=".csv,.tsv,text/csv,text/tab-separated-values,text/plain"
			showColumns={false}
			showDisplaySort={false}
		>
			<Fragment slot="form-options">
				<NumericFilter id="similarity-cutoff" label="Similarity cutoff" defaultValue="0.5" min={0} />
				<NumericFilter id="value-filter" label="Filter Value" />
				<NeighborSort />
			</Fragment>
		</SmilesForm>

		<TopBar
			summaryLabel="Matching Molecules"
			totalLabel="Unique Molecules"
			filteredTotalLabel="Filtered Molecules"
			combineCounts
			sticky={false}
			controlsFirst
		>
			<Slicer slot="controls" idPrefix="query" label="Query" showTotal grow={false} />
		</TopBar>

		<section
			id="gallery-section"
			aria-labelledby="gallery-title"
			class="grid h-[calc(100vh-6rem)] grid-cols-5 gap-4 overflow-hidden pl-4"
		>
			<h1 id="gallery-title" class="sr-only">Nearest-neighbor molecules</h1>
			<ul id="query-card" class="self-start"></ul>
			<ul
				id="gallery"
				class="scrollbar-hover col-span-4 grid max-h-full grid-cols-subgrid auto-rows-max content-start gap-4 overflow-y-auto"
			></ul>
		</section>

		<MoleculeCard />
	</AppShell>

	<script src="@/scripts/nn-viewer.ts"></script>
</BaseLayout>
